# ===============================
#  Flask API Production Dockerfile
# ===============================

# Use a lightweight Python base image
FROM python:3.11-slim

# Set working directory inside container
ENV APP_HOME=/app
WORKDIR $APP_HOME

# System dependencies (install only what's needed for pip builds)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy requirements first for caching
COPY requirements.txt .
COPY wheelhouse/ /wheels/

# Install dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip wheel setuptools && \
    pip install -r requirements.txt

RUN mkdir -p /tmp/uploads
# Copy source code and other necessary folders
COPY src/config_reader.py /app/config_reader.py

COPY src/CSI_Model_Eval_helper.py /app/CSI_Model_Eval_helper.py
COPY src/DL_CSILSTMNet.py /app/DL_CSILSTMNet.py
COPY src/DL_DenseNet1D.py /app/DL_DenseNet1D.py
COPY src/DL_EfficientNet1DLSTM.py /app/DL_EfficientNet1DLSTM.py
COPY src/DL_MobileNetV3.py /app/DL_MobileNetV3.py
COPY src/DS_WifiCSIDataset.py /app/DS_WifiCSIDataset.py
COPY src/flask_real_time_inference.py /app/flask_real_time_inference.py

# Copy configuration files        
COPY config/gait_id_config.properties /app/config/

# Only copy model version marker first
COPY models/.model_version /app/models/.model_version

# later copy full models (only when marker changes)
COPY models/*.pt /app/models/
 
 
# Ensure static directory exists and copy static files
RUN mkdir -p /app/static
COPY src/index.html /app/static/index.html
COPY src/script.js /app/static/script.js

# Ensure Flask binds to all interfaces, not just localhost
ENV FLASK_RUN_HOST=0.0.0.0
ENV FLASK_RUN_PORT=5002
ENV PYTHONUNBUFFERED=1

# Expose the port your Flask app runs on
EXPOSE 5002

# Set environment variable for unbuffered output (for Docker logs)
ENV PYTHONUNBUFFERED=1

# Use Gunicorn for production serving
# Adjust "flask_real_time_inference:app" if your Flask app object is in a different file/module
CMD ["gunicorn", "--bind", "0.0.0.0:5002", "flask_real_time_inference:app", "--workers", "2", "--threads", "4"]


 