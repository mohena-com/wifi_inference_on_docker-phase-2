# flask_real_time_inference.py
from flask import Flask, request, jsonify
from flask_cors import CORS
import logging
import warnings
import os
from pathlib import Path
from datetime import datetime
import traceback
from collections import defaultdict

import numpy as np
import pandas as pd
import torch
import torch.nn as nn
from torch.utils.data import DataLoader

from config_reader import ConfigReader
from CSI_Model_Eval_helper import get_best_model_and_params
from DS_WifiCSIDataset import WifiCSIDataset

# ──────────────────────────────────────────────────────────────────────────────
# Quiet noisy warnings
# ──────────────────────────────────────────────────────────────────────────────
warnings.filterwarnings("ignore", category=DeprecationWarning)
warnings.filterwarnings("ignore", category=FutureWarning)

# ──────────────────────────────────────────────────────────────────────────────
# Flask app + logging
# ──────────────────────────────────────────────────────────────────────────────
app = Flask(__name__)
CORS(app)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
)
logger = logging.getLogger("root")

# ──────────────────────────────────────────────────────────────────────────────
# Config + model checkpoint discovery
# ──────────────────────────────────────────────────────────────────────────────
CONFIG_FILE = os.environ.get("CONFIG_FILE", "config/gait_id_config.properties")
config = ConfigReader(CONFIG_FILE)
print(f"0. Using config file: CONFIG_FILE:{CONFIG_FILE} config:{config}")

best_model_pattern = config.get("best_model_pattern")
model_save_dir = Path(config.get("model_save_path"))
print(f"Model save directory: {model_save_dir.resolve()}")

model_files = list(model_save_dir.glob(best_model_pattern))
print(f"Found model files: {model_files}")
if not model_files:
    raise FileNotFoundError("No model files found")

# Choose one (or pick newest if you prefer)
best_model_path = model_files[0]
print(f"Loading best model from: {best_model_path}")

# ──────────────────────────────────────────────────────────────────────────────
# Build model + load weights (helper handles state_dict)
# ──────────────────────────────────────────────────────────────────────────────
model_instance, params, total_params, device = get_best_model_and_params(str(best_model_path))
print(f"Loaded model: {model_instance.__class__.__name__} from {best_model_path}")

UPLOAD_DIR = "/tmp/uploads"
os.makedirs(UPLOAD_DIR, exist_ok=True)
print(f"INIT DONE: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")

# ──────────────────────────────────────────────────────────────────────────────
# Evaluation helper
# ──────────────────────────────────────────────────────────────────────────────
def evaluate_model_on_input_data(test_loader, model, device, params=None):
    """
    Run inference on DataLoader; return per-window aligned lists:
      actual_idx, actual_raw, pred_idx, pred_raw, files, starts, wins
    """
    import torch.nn.functional as F

    criterion = nn.CrossEntropyLoss()
    print(f"Evaluating model on DataLoader with params: {params} on device: {device}")

    model.eval()
    running_loss, correct, total = 0.0, 0, 0

    actual_idx, actual_raw = [], []
    pred_idx, pred_raw = [], []
    files, starts, wins = [], [], []

    with torch.no_grad():
        for batch_idx, batch in enumerate(test_loader):
            print(f"\n🧩 Processing batch {batch_idx + 1}/{len(test_loader)}")

            csi_seq = batch["csi_seq"].to(device)
            meta_seq = batch["metadata_seq"].to(device)

            csi_seq = torch.nan_to_num(csi_seq, nan=0.0, posinf=1e6, neginf=-1e6)
            meta_seq = torch.nan_to_num(meta_seq, nan=0.0, posinf=1e6, neginf=-1e6)

            outputs = model(csi_seq, meta_seq)           # (N, C=31)
            probs = torch.softmax(outputs, dim=1)        # (N, C)
            preds = torch.argmax(outputs, dim=1)         # (N,)

            # pull batch meta
            b_files = batch.get("file")
            b_starts = batch.get("start")
            b_wins = batch.get("window_size")
            b_labels = batch.get("label")        # indices 0..30
            b_labels_raw = batch.get("label_raw")# raw subject id 1..31

            # loss/acc if labels present
            if b_labels is not None and b_labels.numel() > 0:
                if b_labels.dim() == 2 and b_labels.size(-1) == 1:
                    b_labels = b_labels.squeeze(-1)
                elif b_labels.dim() == 0:
                    b_labels = b_labels.unsqueeze(0)
                b_labels = b_labels.long().to(device)

                loss = criterion(outputs, b_labels)
                running_loss += float(loss.item())
                correct += (preds == b_labels).sum().item()
                total += b_labels.size(0)

            # extend vectors (supports batch_size>=1)
            p_idx = preds.cpu().numpy().tolist()
            pred_idx.extend(p_idx)
            # raw predicted id (assuming mapping idx 0..30 → raw 1..31)
            pred_raw.extend([int(i) + 1 for i in p_idx])

            if b_labels is not None and b_labels.numel() > 0:
                actual_idx.extend(b_labels.cpu().numpy().tolist())
            else:
                actual_idx.extend([None] * len(p_idx))

            if b_labels_raw is not None and b_labels_raw.numel() > 0:
                actual_raw.extend(b_labels_raw.cpu().numpy().tolist())
            else:
                actual_raw.extend([None] * len(p_idx))

            # per-window metadata
            # DataLoader collates strings into list; tensors into tensors
            # Normalize all to Python scalars/strings
            if isinstance(b_files, (list, tuple)):
                files.extend([str(x) for x in b_files])
            else:
                files.extend([str(b_files)] * len(p_idx))

            if hasattr(b_starts, "numel"):
                starts.extend([int(x) for x in b_starts.cpu().numpy().tolist()])
            else:
                starts.extend([int(b_starts)] * len(p_idx))

            if hasattr(b_wins, "numel"):
                wins.extend([int(x) for x in b_wins.cpu().numpy().tolist()])
            else:
                wins.extend([int(b_wins)] * len(p_idx))

    if total > 0:
        avg_loss = running_loss / max(1, len(test_loader))
        acc = 100.0 * correct / total
        print(f"\n✅ Validation complete: Avg Loss={avg_loss:.4f}, Accuracy={acc:.2f}%")
    else:
        print(f"\n✅ Inference complete: {len(pred_idx)} predictions generated.")

    return actual_idx, actual_raw, pred_idx, pred_raw, files, starts, wins

# ──────────────────────────────────────────────────────────────────────────────
# Routes
# ──────────────────────────────────────────────────────────────────────────────
@app.route("/gaitid/index.html", methods=["GET"])
def index_page():
    return jsonify({"status": "ok", "message": "Engine running"})

@app.route("/upload", methods=["POST"])
def upload_file():
    """Upload one or more CSV files and store temporarily."""
    try:
        if "file" not in request.files:
            return jsonify({"error": "No file part 'file' in request"}), 400
        files = request.files.getlist("file")
        if not files:
            return jsonify({"error": "No files uploaded"}), 400

        saved = []
        os.makedirs(UPLOAD_DIR, exist_ok=True)
        for f in files:
            if not f.filename:
                continue
            path = os.path.join(UPLOAD_DIR, f.filename)
            f.save(path)
            saved.append(path)

        if not saved:
            return jsonify({"error": "No valid files saved"}), 400

        return jsonify({"message": f"Uploaded {len(saved)} file(s)", "saved_files": saved}), 200

    except Exception as e:
        logger.error("Upload failed")
        logger.error(traceback.format_exc())
        return jsonify({"error": str(e), "trace": traceback.format_exc()}), 500

@app.route("/gaitid/predict", methods=["POST"])
def predict():
    try:
        if "file" not in request.files:
            return jsonify({"error": "No file part 'file' in request"}), 400
        files = request.files.getlist("file")
        if not files:
            return jsonify({"error": "No files uploaded"}), 400

        saved_paths = []
        for f in files:
            if not f.filename:
                continue
            out_path = os.path.join(UPLOAD_DIR, f.filename)
            f.save(out_path)
            saved_paths.append(out_path)
        if not saved_paths:
            return jsonify({"error": "No valid files saved"}), 400

        # Build dataset/loader. Keep batch_size=1 to simplify row-wise writing.
        ds = WifiCSIDataset(saved_paths)
        test_loader = DataLoader(ds, batch_size=1, shuffle=False, num_workers=0)

        # Run inference
        (
            actual_idx, actual_raw, pred_idx, pred_raw, files_per_win, starts, wins
        ) = evaluate_model_on_input_data(test_loader, model_instance, device, params)

        # Group by source file
        by_file = defaultdict(list)
        for i in range(len(pred_idx)):
            by_file[files_per_win[i]].append({
                "start": int(starts[i]),
                "win": int(wins[i]),
                "actual_raw": actual_raw[i],
                "pred_raw": pred_raw[i],
                "actual_idx": actual_idx[i],
                "pred_idx": pred_idx[i],
            })

        # For each uploaded file, write two extra columns into a copy of the original CSV
        augmented_paths = []
        for fpath in saved_paths:
            base = os.path.basename(fpath)
            df = pd.read_csv(fpath)

            # Ensure the columns exist
            if "actual_subject" not in df.columns:
                df["actual_subject"] = np.nan
            if "predicted_subject" not in df.columns:
                df["predicted_subject"] = np.nan

            # Fill per window into row ranges [start, start+win)
            for rec in by_file.get(base, []):
                s = int(rec["start"])
                e = min(len(df), s + int(rec["win"]))  # exclusive end
                idx = np.arange(s, e, dtype=int)
                if len(idx) == 0:
                    continue
                df.loc[idx, "actual_subject"] = rec["actual_raw"]
                df.loc[idx, "predicted_subject"] = rec["pred_raw"]

            # Save next to upload
            ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            out_csv = os.path.join(os.path.dirname(fpath), f"{os.path.splitext(base)[0]}__with_preds_{ts}.csv")
            df.to_csv(out_csv, index=False)
            augmented_paths.append(out_csv)
            print(f"[REPORT] Wrote: {out_csv}")

        # Optional: also write per-window compact CSV
        per_window_df = pd.DataFrame({
            "file": files_per_win,
            "start": starts,
            "window_size": wins,
            "actual_subject": actual_raw,
            "predicted_subject": pred_raw,
            "actual_idx": actual_idx,
            "predicted_idx": pred_idx,
        })
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        per_window_csv = os.path.join(UPLOAD_DIR, f"predictions_windows_{ts}.csv")
        per_window_df.to_csv(per_window_csv, index=False)
        print(f"[INFO] Saved per-window predictions CSV → {per_window_csv} ({len(per_window_df)} rows)")

        return jsonify({
            "message": "Prediction successful",
            "uploaded_files": len(saved_paths),
            "augmented_csvs": augmented_paths,
            "per_window_csv": per_window_csv
        })

    except Exception as e:
        logger.error("Prediction failed")
        logger.error(traceback.format_exc())
        return jsonify({"error": str(e), "trace": traceback.format_exc()}), 500

# ──────────────────────────────────────────────────────────────────────────────
# Entrypoint
# ──────────────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    # Bind to 0.0.0.0 so Docker port mapping works
    app.run(host="0.0.0.0", port=5002, debug=False)
