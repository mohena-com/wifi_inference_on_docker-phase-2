# Dockerfile.gpu
# TEMPLATE: replace base image with an official PyTorch CUDA runtime that matches your CUDA driver
# e.g. FROM pytorch/pytorch:2.3.0-cuda11.8-cudnn8-runtime  (replace with a valid tag on your infra)
FROM pytorch/pytorch:latest

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip
RUN pip install -r /tmp/requirements.txt

COPY . /app

EXPOSE 8000

ENV MODEL_PAYLOAD_PATH=/app/checkpoints/best_payload.pt
ENV LOCAL_DATA_PATH=/app/data
ENV PORT=8000

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

CMD ["/app/entrypoint.sh"]
